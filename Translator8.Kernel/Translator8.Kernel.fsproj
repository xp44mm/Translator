<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>false</UseWindowsForms>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Token.fs" />
        <Compile Include="Tokens.fs" />
        <Compile Include="Phrase.fs" />
        <Compile Include="PhrasePartition.fs" />
        <Compile Include="Chinese.fs" />
        <Compile Include="Sentence.fs" />
        <Compile Include="Essay.fs" />
        <Compile Include="WordDictionary.fs" />
        <Compile Include="WordOperators.fs" />
        <Compile Include="WordRepository.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Idioms" Version="1.5.16" />
        <PackageReference Include="System.Reactive" Version="7.0.0" />
        <PackageReference Include="System.Reactive.Observable.Aliases" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Translator8.Scaffold\Translator8.Scaffold.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.302" />
    </ItemGroup>

</Project>
